# Copy to .env (or export these in your shell) and fill in real values.
# .env is gitignored — never commit real secrets.

# Signing key for QR badge tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TAILGATE_JWT_SECRET=

# Shared key for the /swipe card-reader API (x-api-key header).
TAILGATE_API_KEY=

# Credentials for the evidence dashboard (HTTP Basic Auth).
TAILGATE_DASHBOARD_USER=guard
TAILGATE_DASHBOARD_PASSWORD=

# Optional: Slack / Teams / webhook.site URL for breach alerts.
# Leave blank to disable outbound alerts.
TAILGATE_WEBHOOK_URL=

# Optional: Telegram bot alert for tailgate breaches. Both must be set to enable.
# 1. Create a bot via @BotFather in Telegram and copy its token.
# 2. Message the bot (or add it to a group) once, then visit
#    https://api.telegram.org/bot<token>/getUpdates to read the chat id.
TAILGATE_TELEGRAM_BOT_TOKEN=
TAILGATE_TELEGRAM_CHAT_ID=

# Bind address for both Flask servers. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY on a trusted network — required for the phone QR flow.
TAILGATE_BIND_HOST=127.0.0.1

# Evidence dashboard port.
TAILGATE_DASHBOARD_PORT=5001

# How long (seconds) a 2FA session stays open after a face match, for the
# employee to complete the QR scan / keycard swipe. Default 20s.
TAILGATE_2FA_TIMEOUT_SECONDS=20

# How long (seconds) a successful swipe/keycard-tap stays valid while waiting
# to be matched against the person's actual tripwire crossing. Default 30s.
TAILGATE_SWIPE_TIMEOUT_SECONDS=30

# Occlusion (hidden second person) detection tuning — raise these if a single
# person's normal arm/leg motion is being flagged as a hidden tailgater.
TAILGATE_OCCLUSION_MEMORY_FRAMES=6
TAILGATE_MIN_OCCLUSION_FRAMES=4
TAILGATE_OPTICAL_FLOW_SPLIT_THRESHOLD=20.0

# Set to "true" on a machine with no attached display (e.g. an on-site server
# running the camera loop unattended). Disables the OpenCV preview window.
TAILGATE_HEADLESS=false
