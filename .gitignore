# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
venv/
env/
ENV/

# Database files
*.db
test_*.db

# Biometric & evidence data — never commit images of real people.
# Breach screenshots and employee reference photos are personal data; committing
# them to a public repository is exactly the disclosure this system exists to
# prevent. Keep them local only.
screenshots/
known_faces/
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.tiff

# Local environment / secrets
.env
.env.*
!.env.example

# IDE & OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db
